# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://postgres:postgres@db:5432/kasparro
APP_API_KEY=change-me

# Optional upstream credentials (leave blank for the keyless/free tiers)
COINGECKO_API_KEY=
COINPAPRIKA_API_KEY=
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# COINPAPRIKA_BASE_URL=https://api.coinpaprika.com/v1

COINGECKO_MAX_RETRIES=5
COINGECKO_MIN_INTERVAL=1.0
COINPAPRIKA_MAX_RETRIES=5
COINPAPRIKA_MIN_INTERVAL=1.0
FAIL_ON_ERROR=1
RUN_ETL_ON_STARTUP=1
