# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://postgres:postgres@db:5432/kasparro

# Client keys (X-API-KEY). Owner: read+admin, API_RATE_LIMIT/min. Demo: read-only, DEMO_API_RATE_LIMIT/min.
# Extra keys: APP_API_KEYS=label:key:limit[:scope+scope],... (keys must not contain ':' or ',')
APP_API_KEY=change-me
APP_DEMO_API_KEY=
APP_API_KEYS=

# Optional upstream credentials (blank = keyless / free tiers)
COINGECKO_API_KEY=
COINPAPRIKA_API_KEY=
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# COINPAPRIKA_BASE_URL=https://api.coinpaprika.com/v1

# Outgoing per-source limits: <SOURCE>_MIN_INTERVAL, _MAX_RETRIES, _BACKOFF_BASE, _BACKOFF_MAX
COINGECKO_MIN_INTERVAL=1.0
COINPAPRIKA_MIN_INTERVAL=1.0

# ETL
RUN_ETL_ON_STARTUP=1
ETL_INTERVAL_SECONDS=0
ETL_BATCH_SIZE=25
ETL_SOURCES=
FAIL_ON_ERROR=1
DRIFT_WARN_THRESHOLD=0.90
DRIFT_REJECT_THRESHOLD=0.60

# API rate limit per key (fixed window, stored in Postgres)
API_RATE_LIMIT=60
DEMO_API_RATE_LIMIT=20
API_RATE_WINDOW_SECONDS=60

# Failure injection (testing only): FAIL_AFTER_N=3 FAIL_MODE=raise|exit FAIL_SOURCES=csv
